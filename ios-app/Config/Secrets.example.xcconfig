// Скопируйте в Secrets.xcconfig и заполните. Secrets.xcconfig не пересылать посторонним.

// API-ключ Google Cloud (Sheets API + Drive API), ограничить по bundle ID приложения.
GOOGLE_API_KEY = AIza...

// Team ID из Apple Developer (Membership → Team ID).
DEVELOPMENT_TEAM = XXXXXXXXXX

// Синхронизация избранного, истории и настроек между iPhone и iPad.
// Нужен платный Apple Developer Program. Без него оставьте две строки ниже закомментированными.
// CLOUDKIT_CONTAINER_ID = iCloud.com.barsky.trenazher
// APP_ENTITLEMENTS = App/Trenazher.entitlements
